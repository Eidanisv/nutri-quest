# Copie este arquivo para ".env.local" e preencha com os valores do SEU projeto Supabase
# (Project Settings → API). Nunca commite o ".env.local".
#
# A "anon public key" é feita para ficar no navegador: quem protege os dados é o RLS
# do banco. NUNCA use aqui a chave "service_role".
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-public-key
